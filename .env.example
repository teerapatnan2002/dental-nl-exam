# ==============================================================================
# NL Dental Treasury — Environment Variables Template
# ==============================================================================
# NEVER commit real secrets to Git. Keep local secrets in `.env` / `.env.local`
# and configure Vercel secrets via Dashboard or `vercel env add <KEY> --sensitive`.

# ── Core Required Variables (Vercel Production & Preview) ─────────────────────

# PostgreSQL / Supabase connection string (REQUIRED on Vercel; SQLite is rejected in prod)
# Recommended Supabase Transaction Pooler (port 6543) with SSL required:
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Local dev default uses SQLite:
DATABASE_URL=sqlite:///./data/exam_bank.db

# Strong JWT signing secret (>= 32 chars REQUIRED in production; app fails fast otherwise)
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARS_HEX

# Comma-separated CORS allowed browser origins (no wildcards in production)
# On Vercel Production, include https://dental-nl-exam.vercel.app (and custom domain if any)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://dental-nl-exam.vercel.app

# OpenRouter API Key for AI Tutor, AI Explain, and AI Mock Generator
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# ── Recommended Security & Feature Variables ──────────────────────────────────

# Dedicated Fernet key (44-char URL-safe base64) for encrypting 2FA TOTP secrets at rest.
# Strongly recommended before rotating SECRET_KEY when 2FA users exist.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Optional AI Tutor model override (defaults to openrouter/free)
TUTOR_MODEL=openrouter/free

# Optional JWT token lifetimes (defaults: 720 minutes access, 30 days refresh)
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Offline / CLI Scripts Only (Not required by Vercel web runtime) ───────────

# Google Gemini API Key (only used by local OCR/enrichment CLI scripts)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
